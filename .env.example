
# Kopiera denna fil till .env.local och fyll i värden från ditt Supabase-projekt
# (Project Settings → API).

NEXT_PUBLIC_SUPABASE_URL=https://ditt-projekt.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=din-anon-key

# Krävs endast för att bjuda in/ta bort kollegor (server-side, Service role-nyckel).
# Får ALDRIG exponeras till klienten eller committas.
SUPABASE_SERVICE_ROLE_KEY=din-service-role-key
